<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <title>Spa Deseo</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
            font-family: Arial, Helvetica, sans-serif;
            background: linear-gradient(135deg, #ffdce9 0%, #ffc6da 45%, #ff9fbe 100%);
        }

        .watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            z-index: 0;
            width: 1000px;
            max-width: 100vw;
            transform: translate(-50%, -50%);
            opacity: 0.1;
            pointer-events: none;
            filter: saturate(1.5);
        }

        .watermark img {
            display: block;
            width: 100%;
        }

        .login-container {
            position: relative;
            z-index: 2;
            width: 390px;
            max-width: 90%;
            padding: 40px;
            border: 1px solid rgba(255, 255, 255, 0.75);
            border-radius: 25px;
            background: rgba(255, 248, 251, 0.78);
            box-shadow: 0 20px 45px rgba(210, 40, 105, 0.2);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            text-align: center;
        }

        .login-logo {
            display: block;
            width: 150px;
            max-width: 100%;
            margin: 0 auto 12px;
        }

        h1 {
            margin-bottom: 8px;
            color: #d92f70;
            font-size: 30px;
        }

        .subtitulo {
            margin-bottom: 28px;
            color: #8d6879;
            font-size: 14px;
        }

        .mensaje {
            display: none;
            margin-bottom: 20px;
            padding: 12px;
            border-left: 4px solid #f43f7f;
            border-radius: 10px;
            background-color: #ffe4ef;
            color: #c52d66;
            font-size: 14px;
            text-align: left;
        }

        .mensaje.exito,
        .mensaje.error {
            display: block;
        }

        .mensaje.exito {
            border-left-color: #45a36b;
            background: #e8f5e9;
            color: #2e7d32;
        }

        .form-group {
            margin-bottom: 18px;
            text-align: left;
        }

        .form-group label {
            display: block;
            margin-bottom: 7px;
            color: #b82d63;
            font-size: 14px;
            font-weight: 600;
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper span {
            position: absolute;
            top: 50%;
            left: 15px;
            transform: translateY(-50%);
            color: #ef407c;
            font-size: 17px;
        }

        input {
            width: 100%;
            height: 48px;
            padding: 0 15px 0 45px;
            border: 1px solid #f2b3ca;
            border-radius: 12px;
            outline: none;
            background: rgba(255, 255, 255, 0.8);
            color: #6d4657;
            font-size: 14px;
            transition: 0.3s;
        }

        input::placeholder {
            color: #b99ca9;
        }

        input:focus {
            border-color: #ef3f7c;
            background: white;
            box-shadow: 0 0 0 3px rgba(239, 63, 124, 0.12);
        }

        .btn-login {
            width: 100%;
            height: 48px;
            margin-top: 8px;
            border: none;
            border-radius: 12px;
            background: linear-gradient(135deg, #ff4f91, #e91e63);
            box-shadow: 0 8px 18px rgba(233, 30, 99, 0.25);
            color: white;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(233, 30, 99, 0.32);
        }

        .btn-login:disabled {
            cursor: not-allowed;
            opacity: 0.7;
            transform: none;
        }

        .registro {
            margin-top: 22px;
            color: #795866;
            font-size: 14px;
        }

        a {
            color: #e91e63;
            font-weight: bold;
            text-decoration: none;
        }

        a:hover {
            text-decoration: underline;
        }

        @media (max-width: 500px) {
            .login-container {
                padding: 30px 24px;
            }

            .watermark {
                width: 600px;
            }

            h1 {
                font-size: 26px;
            }
        }
    </style>
</head>

<body>
    <div class="watermark" aria-hidden="true">
        <img src="/img/logo-spa-deseo-fucsia.png" alt="">
    </div>

    <main class="login-container">
        <img class="login-logo" src="/img/logo-spa-deseo-fucsia.png" alt="Spa Deseo">
        <h1>Spa Deseo</h1>
        <p class="subtitulo">Inicia sesión en tu cuenta</p>

        <div id="mensaje" class="mensaje" role="alert"></div>

        <form id="formLogin">
            <div class="form-group">
                <label for="correo">Correo electrónico</label>
                <div class="input-wrapper">
                    <span class="fa-solid fa-envelope" aria-hidden="true"></span>
                    <input type="email" id="correo" name="correo" placeholder="correo@ejemplo.com" autocomplete="email" required>
                </div>
            </div>

            <div class="form-group">
                <label for="password">Contraseña</label>
                <div class="input-wrapper">
                    <span class="fa-solid fa-lock" aria-hidden="true"></span>
                    <input type="password" id="password" name="password" placeholder="Ingresa tu contraseña" autocomplete="current-password" required>
                </div>
            </div>

            <button type="submit" class="btn-login" id="btnLogin">Iniciar sesión</button>
        </form>

        <div class="registro">
            ¿No tienes una cuenta?
            <a href="/registro">Crear cuenta</a>
        </div>
    </main>

    <script>
        const formulario = document.getElementById('formLogin');
        const mensaje = document.getElementById('mensaje');
        const boton = document.getElementById('btnLogin');

        formulario.addEventListener('submit', async (event) => {
            event.preventDefault();

            // Limpiar mensaje previa presentación
            mensaje.style.display = 'none';
            mensaje.className = 'mensaje';

            // Desactivar botón
            boton.disabled = true;
            boton.textContent = 'Iniciando sesión...';

            const correo = document.getElementById('correo').value.trim();
            const password = document.getElementById('password').value;

            try {
                const respuesta = await fetch('/api/usuarios/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ correo, password })
                });

                const datos = await respuesta.json();

                if (!respuesta.ok) {
                    throw new Error(datos.mensaje || 'No se pudo iniciar sesión.');
                }

                if (!datos.token) {
                    throw new Error('Respuesta inválida: No se recibió token.');
                }

                // Guardar Token en localStorage (consistente con Dashboard)
                localStorage.setItem('token', datos.token);

                if (datos.usuario) {
                    localStorage.setItem('usuario', JSON.stringify(datos.usuario));
                }

                // Mostrar éxito
                mensaje.textContent = datos.mensaje || 'Inicio de sesión exitoso.';
                mensaje.classList.add('exito');
                mensaje.style.display = 'block';

                // Redirección
                setTimeout(() => {
                    window.location.href = '/dashboard';
                }, 1000);

            } catch (error) {
                mensaje.textContent = error.message;
                mensaje.classList.add('error');
                mensaje.style.display = 'block';
            } finally {
                boton.disabled = false;
                boton.textContent = 'Iniciar sesión';
            }
        });
    </script>
</body>
</html>