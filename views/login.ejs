
<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Iniciar sesión | Spa Deseo</title>


    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }


        body {

            min-height: 100vh;

            display: flex;

            justify-content: center;

            align-items: center;

            font-family: Arial, sans-serif;

            background:
                linear-gradient(
                    135deg,
                    #fce4ec,
                    #f3e5f5
                );

        }


        .contenedor {

            width: 100%;

            max-width: 450px;

            padding: 20px;

        }


        .tarjeta {

            background: white;

            padding: 40px;

            border-radius: 25px;

            box-shadow:
                0 15px 40px
                rgba(0, 0, 0, 0.12);

        }


        .logo {

            text-align: center;

            margin-bottom: 10px;

            color: #c2185b;

            font-size: 34px;

        }


        .subtitulo {

            text-align: center;

            color: #777;

            margin-bottom: 30px;

        }


        .campo {

            margin-bottom: 20px;

        }


        .campo label {

            display: block;

            margin-bottom: 8px;

            color: #444;

            font-weight: bold;

        }


        .campo input {

            width: 100%;

            padding: 13px 15px;

            border: 1px solid #ddd;

            border-radius: 12px;

            font-size: 15px;

            outline: none;

            transition: 0.3s;

        }


        .campo input:focus {

            border-color: #c2185b;

            box-shadow:
                0 0 0 3px
                rgba(194, 24, 91, 0.10);

        }


        .boton {

            width: 100%;

            padding: 14px;

            border: none;

            border-radius: 12px;

            background: #c2185b;

            color: white;

            font-size: 16px;

            font-weight: bold;

            cursor: pointer;

            transition: 0.3s;

        }


        .boton:hover {

            background: #ad1457;

            transform: translateY(-1px);

        }


        .boton:disabled {

            opacity: 0.7;

            cursor: not-allowed;

            transform: none;

        }


        .mensaje {

            display: none;

            padding: 12px;

            margin-bottom: 20px;

            border-radius: 10px;

            text-align: center;

            font-size: 14px;

        }


        .mensaje.exito {

            display: block;

            background: #e8f5e9;

            color: #2e7d32;

        }


        .mensaje.error {

            display: block;

            background: #ffebee;

            color: #c62828;

        }


        .registro {

            text-align: center;

            margin-top: 25px;

            color: #777;

        }


        .registro a {

            color: #c2185b;

            text-decoration: none;

            font-weight: bold;

        }


        .registro a:hover {

            text-decoration: underline;

        }

    </style>

</head>


<body>


    <main class="contenedor">

        <section class="tarjeta">


            <h1 class="logo">
                💅 Spa Deseo
            </h1>


            <p class="subtitulo">
                Inicia sesión en tu cuenta
            </p>


            <!-- MENSAJE -->

            <div
                id="mensaje"
                class="mensaje"
            ></div>


            <!-- FORMULARIO -->

            <form id="formLogin">


                <!-- CORREO -->

                <div class="campo">

                    <label for="correo">
                        Correo electrónico
                    </label>

                    <input
                        type="email"
                        id="correo"
                        name="correo"
                        placeholder="correo@ejemplo.com"
                        autocomplete="email"
                        required
                    >

                </div>


                <!-- CONTRASEÑA -->

                <div class="campo">

                    <label for="password">
                        Contraseña
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Ingresa tu contraseña"
                        autocomplete="current-password"
                        required
                    >

                </div>


                <!-- BOTÓN -->

                <button
                    type="submit"
                    class="boton"
                    id="btnLogin"
                >
                    Iniciar sesión
                </button>


            </form>


            <!-- REGISTRO -->

            <div class="registro">

                ¿No tienes una cuenta?

                <a href="/registro">
                    Crear cuenta
                </a>

            </div>


        </section>

    </main>


    <script>


        // =====================================================
        // ELEMENTOS DEL DOM
        // =====================================================

        const formulario =
            document.getElementById(
                'formLogin'
            );


        const mensaje =
            document.getElementById(
                'mensaje'
            );


        const boton =
            document.getElementById(
                'btnLogin'
            );


        // =====================================================
        // LOGIN
        // =====================================================

        formulario.addEventListener(
            'submit',
            async (event) => {

                event.preventDefault();


                // Limpiar mensaje

                mensaje.style.display =
                    'none';

                mensaje.className =
                    'mensaje';


                // Desactivar botón

                boton.disabled = true;

                boton.textContent =
                    'Iniciando sesión...';


                // Obtener datos

                const correo =
                    document
                        .getElementById('correo')
                        .value
                        .trim();


                const password =
                    document
                        .getElementById('password')
                        .value;


                try {


                    // =================================================
                    // ENVIAR DATOS AL BACKEND
                    // =================================================

                    const respuesta =
                        await fetch(
                            '/api/usuarios/login',
                            {

                                method: 'POST',

                                headers: {

                                    'Content-Type':
                                        'application/json'

                                },

                                body:
                                    JSON.stringify({

                                        correo,

                                        password

                                    })

                            }
                        );


                    // =================================================
                    // LEER RESPUESTA
                    // =================================================

                    const datos =
                        await respuesta.json();


                    // =================================================
                    // ERROR
                    // =================================================

                    if (!respuesta.ok) {

                        throw new Error(

                            datos.mensaje ||
                            'No se pudo iniciar sesión.'

                        );

                    }


                    // =================================================
                    // GUARDAR JWT
                    // =================================================

                    sessionStorage.setItem(
                        'token',
                        datos.token
                    );


                    // =================================================
                    // MENSAJE DE ÉXITO
                    // =================================================

                    mensaje.textContent =
                        datos.mensaje ||
                        'Inicio de sesión exitoso.';


                    mensaje.classList.add(
                        'exito'
                    );


                    mensaje.style.display =
                        'block';


                    // =================================================
                    // REDIRECCIÓN
                    // =================================================

                    setTimeout(() => {

                        window.location.href =
                            '/dashboard';

                    }, 1000);


                } catch (error) {


                    // =================================================
                    // MOSTRAR ERROR
                    // =================================================

                    mensaje.textContent =
                        error.message;


                    mensaje.classList.add(
                        'error'
                    );


                    mensaje.style.display =
                        'block';


                } finally {


                    // =================================================
                    // RESTAURAR BOTÓN
                    // =================================================

                    boton.disabled = false;

                    boton.textContent =
                        'Iniciar sesión';

                }

            }
        );


    </script>


</body>

</html>

