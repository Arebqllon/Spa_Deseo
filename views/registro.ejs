<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Registro | Spa Deseo</title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {

            min-height: 100vh;

            display: flex;

            justify-content: center;

            align-items: center;

            font-family: Arial, sans-serif;

            background:
                linear-gradient(
                    135deg,
                    #fce4ec,
                    #f3e5f5
                );

        }

        .contenedor {

            width: 100%;

            max-width: 450px;

            padding: 20px;

        }

        .tarjeta {

            background: white;

            padding: 40px;

            border-radius: 25px;

            box-shadow:
                0 15px 40px rgba(0, 0, 0, 0.12);

        }

        .logo {

            text-align: center;

            margin-bottom: 10px;

            color: #c2185b;

            font-size: 32px;

        }

        .subtitulo {

            text-align: center;

            color: #777;

            margin-bottom: 30px;

        }

        .campo {

            margin-bottom: 20px;

        }

        .campo label {

            display: block;

            margin-bottom: 8px;

            color: #444;

            font-weight: bold;

        }

        .campo input,
        .campo select {

            width: 100%;

            padding: 13px 15px;

            border: 1px solid #ddd;

            border-radius: 12px;

            font-size: 15px;

            outline: none;

            transition: 0.3s;

        }

        .campo input:focus,
        .campo select:focus {

            border-color: #c2185b;

            box-shadow:
                0 0 0 3px rgba(
                    194,
                    24,
                    91,
                    0.10
                );

        }

        .boton {

            width: 100%;

            padding: 14px;

            border: none;

            border-radius: 12px;

            background: #c2185b;

            color: white;

            font-size: 16px;

            font-weight: bold;

            cursor: pointer;

            transition: 0.3s;

        }

        .boton:hover {

            background: #ad1457;

            transform: translateY(-1px);

        }

        .mensaje {

            display: none;

            padding: 12px;

            margin-bottom: 20px;

            border-radius: 10px;

            text-align: center;

            font-size: 14px;

        }

        .mensaje.exito {

            display: block;

            background: #e8f5e9;

            color: #2e7d32;

        }

        .mensaje.error {

            display: block;

            background: #ffebee;

            color: #c62828;

        }

        .login {

            text-align: center;

            margin-top: 25px;

            color: #777;

        }

        .login a {

            color: #c2185b;

            text-decoration: none;

            font-weight: bold;

        }

        .login a:hover {

            text-decoration: underline;

        }

    </style>

</head>


<body>

    <main class="contenedor">

        <section class="tarjeta">

            <h1 class="logo">
                💅 Spa Deseo
            </h1>

            <p class="subtitulo">
                Crea tu cuenta
            </p>


            <div
                id="mensaje"
                class="mensaje"
            ></div>


            <form id="formRegistro">


                <!-- CORREO -->

                <div class="campo">

                    <label for="correo">
                        Correo electrónico
                    </label>

                    <input
                        type="email"
                        id="correo"
                        name="correo"
                        placeholder="correo@ejemplo.com"
                        required
                    >

                </div>


                <!-- CONTRASEÑA -->

                <div class="campo">

                    <label for="password">
                        Contraseña
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Ingresa una contraseña"
                        minlength="6"
                        required
                    >

                </div>


                <!-- ROL -->

                <div class="campo">

                    <label for="rol">
                        Tipo de usuario
                    </label>

                    <select
                        id="rol"
                        name="rol"
                        required
                    >

                        <option value="">
                            Selecciona tu rol
                        </option>

                        <option value="Cliente">
                            Cliente
                        </option>

                        <option value="Manicurista">
                            Manicurista
                        </option>

                        <option value="Administrador">
                            Administrador
                        </option>

                    </select>

                </div>


                <!-- BOTÓN -->

                <button
                    type="submit"
                    class="boton"
                    id="btnRegistro"
                >
                    Crear cuenta
                </button>

            </form>


            <div class="login">

                ¿Ya tienes una cuenta?

                <a href="/login">
                    Iniciar sesión
                </a>

            </div>

        </section>

    </main>


    <script>

        const formulario =
            document.getElementById(
                'formRegistro'
            );

        const mensaje =
            document.getElementById(
                'mensaje'
            );

        const boton =
            document.getElementById(
                'btnRegistro'
            );


        formulario.addEventListener(
            'submit',
            async (event) => {

                event.preventDefault();


                mensaje.style.display =
                    'none';

                mensaje.className =
                    'mensaje';


                boton.disabled = true;

                boton.textContent =
                    'Registrarse';


                const correo =
                    document
                        .getElementById('correo')
                        .value
                        .trim();

                const password =
                    document
                        .getElementById('password')
                        .value;

                const rol =
                    document
                        .getElementById('rol')
                        .value;


                try {


                    const respuesta =
                        await fetch(
                            '/api/usuarios/registro',
                            {

                                method: 'POST',

                                headers: {
                                    'Content-Type':
                                        'application/json'
                                },

                                body:
                                    JSON.stringify({
                                        correo,
                                        password,
                                        rol
                                    })

                            }
                        );


                    const datos =
                        await respuesta.json();


                    if (!respuesta.ok) {

                        throw new Error(
                            datos.mensaje ||
                            'No se pudo registrar el usuario.'
                        );

                    }


                    mensaje.textContent =
                        datos.mensaje ||
                        'Usuario registrado correctamente.';

                    mensaje.classList.add(
                        'exito'
                    );

                    mensaje.style.display =
                        'block';


                    formulario.reset();


                    /*
                     * Después de registrarse,
                     * esperamos unos segundos
                     * y enviamos al login.
                     */

                    setTimeout(() => {

                        window.location.href =
                            '/login';

                    }, 2500);


                } catch (error) {
              
       mensaje.textContent = error.message;

                    mensaje.classList.add(
                        'error'
                    );

                    mensaje.style.display =
                        'block';

                } finally {

                    boton.disabled = false;

       POST /api/usuarios/registr
                    boton.textContent =
                        'Crear cuenta';

                }

            }
        );

    </script>

</body>

</html>
