<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <title>Registro | Spa Deseo</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
            padding: 20px 0;
            font-family: Arial, Helvetica, sans-serif;
            background: linear-gradient(135deg, #ffdce9 0%, #ffc6da 45%, #ff9fbe 100%);
        }

        .watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            z-index: 0;
            width: 1000px;
            max-width: 100vw;
            transform: translate(-50%, -50%);
            opacity: 0.1;
            pointer-events: none;
            filter: saturate(1.5);
        }

        .watermark img {
            display: block;
            width: 100%;
        }

        .login-container {
            position: relative;
            z-index: 2;
            width: 430px;
            max-width: 90%;
            padding: 24px 30px 22px;
            border: 1px solid rgba(255, 255, 255, 0.75);
            border-radius: 25px;
            background: rgba(255, 248, 251, 0.78);
            box-shadow: 0 20px 45px rgba(210, 40, 105, 0.2);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            text-align: center;
        }

        .login-logo {
            display: block;
            width: 92px;
            max-width: 100%;
            margin: 0 auto 6px;
        }

        h1 {
            margin-bottom: 5px;
            color: #d92f70;
            font-size: 25px;
        }

        .subtitulo {
            margin-bottom: 14px;
            color: #8d6879;
            font-size: 14px;
        }

        .mensaje {
            display: none;
            margin-bottom: 12px;
            padding: 9px;
            border-left: 4px solid #f43f7f;
            border-radius: 10px;
            background-color: #ffe4ef;
            color: #c52d66;
            font-size: 14px;
            text-align: left;
        }

        .mensaje.exito,
        .mensaje.error {
            display: block;
        }

        .mensaje.exito {
            border-left-color: #45a36b;
            background: #e8f5e9;
            color: #2e7d32;
        }

        .form-group {
            margin-bottom: 10px;
            text-align: left;
        }

        .form-group label {
            display: block;
            margin-bottom: 4px;
            color: #b82d63;
            font-size: 12px;
            font-weight: 600;
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper span {
            position: absolute;
            top: 50%;
            left: 13px;
            transform: translateY(-50%);
            color: #ef407c;
            font-size: 14px;
        }

        input {
            width: 100%;
            height: 42px;
            padding: 0 12px 0 38px;
            border: 1px solid #f2b3ca;
            border-radius: 12px;
            outline: none;
            background: rgba(255, 255, 255, 0.8);
            color: #6d4657;
            font-family: inherit;
            font-size: 13px;
            transition: 0.3s;
        }

        input::placeholder {
            color: #b99ca9;
        }

        input:focus {
            border-color: #ef3f7c;
            background: white;
            box-shadow: 0 0 0 3px rgba(239, 63, 124, 0.12);
        }

        .password-help {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2px 8px;
            margin-top: 5px;
            padding: 6px 9px;
            border-radius: 9px;
            background: #fff0f6;
        }

        .password-help p {
            margin: 1px 0;
            color: #b99ca9;
            font-size: 11px;
            transition: 0.2s;
        }

        .password-help p.valido {
            color: #e91e63;
            font-weight: bold;
        }

        .btn-login {
            width: 100%;
            height: 42px;
            margin-top: 3px;
            border: none;
            border-radius: 12px;
            background: linear-gradient(135deg, #ff4f91, #e91e63);
            box-shadow: 0 8px 18px rgba(233, 30, 99, 0.25);
            color: white;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(233, 30, 99, 0.32);
        }

        .btn-login:disabled {
            cursor: not-allowed;
            opacity: 0.7;
            transform: none;
        }

        .registro {
            margin-top: 14px;
            color: #795866;
            font-size: 14px;
        }

        a {
            color: #e91e63;
            font-weight: bold;
            text-decoration: none;
        }

        a:hover {
            text-decoration: underline;
        }

        @media (max-width: 500px) {
            body {
                overflow: auto;
            }

            .login-container {
                padding: 24px 20px;
            }

            .watermark {
                width: 600px;
            }

            h1 {
                font-size: 26px;
            }
        }
    </style>
</head>

<body>
    <div class="watermark" aria-hidden="true">
        <img src="/img/logo-spa-deseo-fucsia.png" alt="">
    </div>

    <main class="login-container">
        <img class="login-logo" src="/img/logo-spa-deseo-fucsia.png" alt="Spa Deseo">
        <h1>Crear cuenta</h1>
        <p class="subtitulo">Regístrate para disfrutar de Spa Deseo</p>

        <div id="mensaje" class="mensaje" role="alert"></div>

        <form id="formRegistro">
            <div class="form-group">
                <label for="nombre">Nombre</label>
                <div class="input-wrapper">
                    <span class="fa-solid fa-user" aria-hidden="true"></span>
                    <input type="text" id="nombre" name="nombre" placeholder="Tu nombre" minlength="3" maxlength="100" pattern="[A-Za-zÁÉÍÓÚáéíóúñÑ ]+" autocomplete="given-name" required>
                </div>
            </div>

            <div class="form-group">
                <label for="apellido">Apellido</label>
                <div class="input-wrapper">
                    <span class="fa-solid fa-user" aria-hidden="true"></span>
                    <input type="text" id="apellido" name="apellido" placeholder="Tu apellido" minlength="3" maxlength="100" pattern="[A-Za-zÁÉÍÓÚáéíóúñÑ ]+" autocomplete="family-name" required>
                </div>
            </div>

            <div class="form-group">
                <label for="telefono">Teléfono</label>
                <div class="input-wrapper">
                    <span class="fa-solid fa-phone" aria-hidden="true"></span>
                    <input type="tel" id="telefono" name="telefono" placeholder="3001234567" minlength="7" maxlength="20" pattern="[0-9]+" autocomplete="tel" required>
                </div>
            </div>

            <div class="form-group">
                <label for="correo">Correo electrónico</label>
                <div class="input-wrapper">
                    <span class="fa-solid fa-envelope" aria-hidden="true"></span>
                    <input type="email" id="correo" name="correo" placeholder="ejemplo@correo.com" maxlength="100" autocomplete="email" required>
                </div>
            </div>

            <div class="form-group">
                <label for="password">Contraseña</label>
                <div class="input-wrapper">
                    <span class="fa-solid fa-lock" aria-hidden="true"></span>
                    <input type="password" id="password" name="password" placeholder="Crea una contraseña" minlength="8" maxlength="20" pattern="(?=.*[A-Z])(?=.*[a-z])(?=.*[0-9]).*" autocomplete="new-password" required>
                </div>
                <div class="password-help" aria-live="polite">
                    <p id="longitud">8 caracteres como mínimo</p>
                    <p id="mayuscula">Una letra mayúscula</p>
                    <p id="minuscula">Una letra minúscula</p>
                    <p id="numero">Un número</p>
                </div>
            </div>

            <button type="submit" class="btn-login" id="btnRegistro">Registrarse</button>
        </form>

        <p class="registro">
            ¿Ya tienes una cuenta?
            <a href="/login">Inicia sesión</a>
        </p>
    </main>

    <script>
        const formulario = document.getElementById('formRegistro');
        const mensaje = document.getElementById('mensaje');
        const boton = document.getElementById('btnRegistro');
        const password = document.getElementById('password');

        password.addEventListener('input', () => {
            const valor = password.value;

            document.getElementById('longitud').classList.toggle('valido', valor.length >= 8);
            document.getElementById('mayuscula').classList.toggle('valido', /[A-Z]/.test(valor));
            document.getElementById('minuscula').classList.toggle('valido', /[a-z]/.test(valor));
            document.getElementById('numero').classList.toggle('valido', /\d/.test(valor));
        });

        formulario.addEventListener('submit', async (event) => {
            event.preventDefault();
            mensaje.style.display = 'none';
            mensaje.className = 'mensaje';
            boton.disabled = true;
            boton.textContent = 'Registrando...';

            const nombre = document.getElementById('nombre').value.trim();
            const apellido = document.getElementById('apellido').value.trim();
            const telefono = document.getElementById('telefono').value.trim();
            const correo = document.getElementById('correo').value.trim();
            const passwordValue = password.value;

            try {
                const respuesta = await fetch('/api/usuarios/registro', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        nombre,
                        apellido,
                        telefono,
                        correo,
                        password: passwordValue
                    })
                });

                const datos = await respuesta.json();

                if (!respuesta.ok) {
                    throw new Error(datos.mensaje || 'No se pudo registrar el usuario.');
                }

                mensaje.textContent = datos.mensaje || 'Usuario registrado correctamente.';
                mensaje.classList.add('exito');
                mensaje.style.display = 'block';
                formulario.reset();
                document.querySelectorAll('.password-help p').forEach((criterio) => criterio.classList.remove('valido'));

                setTimeout(() => {
                    window.location.href = '/login';
                }, 2500);
            } catch (error) {
                mensaje.textContent = error.message;
                mensaje.classList.add('error');
                mensaje.style.display = 'block';
            } finally {
                boton.disabled = false;
                boton.textContent = 'Registrarse';
            }
        });
    </script>
</body>

</html>
