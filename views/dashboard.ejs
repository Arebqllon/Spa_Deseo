<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard | Spa Deseo</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f6f8;
            padding: 30px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: white;
            padding: 20px 30px;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
            margin-bottom: 20px;
        }

        .btn-logout {
            background: #e53935;
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn-logout:hover {
            background: #c62828;
        }

        .navegacion {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .btn-tab {
            padding: 12px 20px;
            background: white;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            color: #555;
            transition: 0.3s;
        }

        .btn-tab:hover {
            background: #fce4ec;
            color: #c2185b;
        }

        .btn-tab.activo {
            background: #c2185b;
            color: white;
            border-color: #c2185b;
        }

        .contenido {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        }

        .seccion-tab {
            display: none;
        }

        .seccion-tab.activa {
            display: block;
        }

        .campo {
            margin-bottom: 15px;
        }

        .campo label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
            color: #444;
        }

        .campo input,
        .campo select {
            width: 100%;
            max-width: 400px;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 6px;
        }

        .btn-guardar {
            background: #c2185b;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
        }

        .btn-guardar:hover {
            background: #ad1457;
        }

        ul {
            list-style: none;
            margin-top: 15px;
        }

        li {
            padding: 12px;
            border-bottom: 1px solid #eee;
        }

        .mensaje-res {
            margin-top: 15px;
            font-weight: bold;
            color: #2e7d32;
        }
    </style>
</head>

<body>

    <!-- =====================================================
         ENCABEZADO
    ====================================================== -->

    <div class="header">

        <h2>Panel de Control - Spa Deseo</h2>

        <button class="btn-logout" id="btnLogout">
            Cerrar Sesión
        </button>

    </div>


    <!-- =====================================================
         NAVEGACIÓN
    ====================================================== -->

    <div class="navegacion">

        <button
            class="btn-tab activo"
            onclick="cambiarPestana('mis-citas', this)"
        >
            Mis Citas
        </button>

        <button
            class="btn-tab"
            onclick="cambiarPestana('agendar', this)"
        >
            Agendar Cita
        </button>

        <button
            class="btn-tab"
            onclick="cambiarPestana('perfil', this)"
        >
            Editar Perfil
        </button>

    </div>


    <div class="contenido">


        <!-- =====================================================
             MIS CITAS
        ====================================================== -->

        <section
            id="sec-mis-citas"
            class="seccion-tab activa"
        >

            <h3>Citas Programadas</h3>

            <ul id="listaCitas">

                <li>
                    Cargando citas...
                </li>

            </ul>

        </section>


        <!-- =====================================================
             AGENDAR CITA
        ====================================================== -->

        <section
            id="sec-agendar"
            class="seccion-tab"
        >

            <h3>Agendar Nueva Cita</h3>

            <form
                id="formAgendar"
                style="margin-top: 15px;"
            >

                <!-- SERVICIO -->

                <div class="campo">

                    <label for="servicio">
                        Servicio
                    </label>

                    <select
                        id="servicio"
                        required
                    >

                        <option value="">
                            Cargando servicios...
                        </option>

                    </select>

                </div>


                <!-- MANICURISTA -->

                <div class="campo">

                    <label for="manicurista">
                        Manicurista / Especialista
                    </label>

                    <select
                        id="manicurista"
                        required
                    >

                        <option value="">
                            Cargando manicuristas...
                        </option>

                    </select>

                </div>


                <!-- FECHA Y HORA -->

                <div class="campo">

                    <label for="fecha">
                        Fecha y Hora
                    </label>

                    <input
                        type="datetime-local"
                        id="fecha"
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="btn-guardar"
                >
                    Confirmar Cita
                </button>

            </form>


            <div
                id="msgAgendar"
                class="mensaje-res"
            ></div>

        </section>


        <!-- =====================================================
             EDITAR PERFIL
        ====================================================== -->

        <section
            id="sec-perfil"
            class="seccion-tab"
        >

            <h3>Editar Perfil</h3>

            <form
                id="formPerfil"
                style="margin-top: 15px;"
            >

                <div class="campo">

                    <label for="nombrePerfil">
                        Nombre completo
                    </label>

                    <input
                        type="text"
                        id="nombrePerfil"
                        required
                    >

                </div>


                <div class="campo">

                    <label for="correoPerfil">
                        Correo electrónico
                    </label>

                    <input
                        type="email"
                        id="correoPerfil"
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="btn-guardar"
                >
                    Actualizar Datos
                </button>

            </form>


            <div
                id="msgPerfil"
                class="mensaje-res"
            ></div>

        </section>

    </div>


    <script>

        // =====================================================
        // DATOS DE AUTENTICACIÓN
        // =====================================================

        const token = localStorage.getItem('token');

        const usuarioStr =
            localStorage.getItem('usuario');


        // =====================================================
        // CARGAR DASHBOARD
        // =====================================================

        document.addEventListener('DOMContentLoaded', () => {

            if (
                !token ||
                token === 'undefined' ||
                token === 'null'
            ) {

                cerrarSesion();

                return;
            }


            if (!usuarioStr) {

                cerrarSesion();

                return;
            }


            let usuario;

            try {

                usuario = JSON.parse(usuarioStr);

            } catch (error) {

                cerrarSesion();

                return;
            }


            console.log(
                'Usuario autenticado:',
                usuario
            );


            // Cargar información

            cargarCitas();

            cargarDatosPerfil();

            cargarServicios();

            cargarManicuristas();

        });


        // =====================================================
        // CAMBIAR PESTAÑA
        // =====================================================

        function cambiarPestana(
            pestana,
            boton
        ) {

            document
                .querySelectorAll('.seccion-tab')
                .forEach(sec => {

                    sec.classList.remove('activa');

                });


            document
                .querySelectorAll('.btn-tab')
                .forEach(btn => {

                    btn.classList.remove('activo');

                });


            if (pestana === 'mis-citas') {

                document
                    .getElementById('sec-mis-citas')
                    .classList.add('activa');

                boton.classList.add('activo');

                cargarCitas();

            }


            else if (pestana === 'agendar') {

                document
                    .getElementById('sec-agendar')
                    .classList.add('activa');

                boton.classList.add('activo');

            }


            else if (pestana === 'perfil') {

                document
                    .getElementById('sec-perfil')
                    .classList.add('activa');

                boton.classList.add('activo');

            }

        }


        // =====================================================
        // CARGAR SERVICIOS
        // =====================================================

        async function cargarServicios() {

            const select =
                document.getElementById('servicio');


            try {

                const respuesta = await fetch(
                    '/api/servicios'
                );


                const datos =
                    await respuesta.json();


                if (
                    !respuesta.ok ||
                    !datos.ok
                ) {

                    throw new Error(
                        datos.mensaje ||
                        'No se pudieron cargar los servicios.'
                    );

                }


                select.innerHTML =
                    '<option value="">Selecciona un servicio</option>';


                datos.servicios.forEach(servicio => {

                    const opcion =
                        document.createElement('option');


                    opcion.value =
                        servicio._id;


                    opcion.textContent =
                        servicio.nombre;


                    select.appendChild(opcion);

                });


            } catch (error) {

                console.error(
                    'Error cargando servicios:',
                    error
                );


                select.innerHTML =
                    '<option value="">No hay servicios disponibles</option>';

            }

        }


        // =====================================================
        // CARGAR MANICURISTAS
        // =====================================================

        async function cargarManicuristas() {

            const select =
                document.getElementById('manicurista');


            try {

                const respuesta = await fetch(
                    '/api/manicuristas'
                );


                const datos =
                    await respuesta.json();


                if (
                    !respuesta.ok ||
                    !datos.ok
                ) {

                    throw new Error(
                        datos.mensaje ||
                        'No se pudieron cargar las manicuristas.'
                    );

                }


                select.innerHTML =
                    '<option value="">Selecciona una manicurista</option>';


                datos.manicuristas.forEach(manicurista => {

                    const opcion =
                        document.createElement('option');


                    opcion.value =
                        manicurista._id;


                    opcion.textContent =
                        `${manicurista.nombre} ${manicurista.apellido}`;


                    select.appendChild(opcion);

                });


            } catch (error) {

                console.error(
                    'Error cargando manicuristas:',
                    error
                );


                select.innerHTML =
                    '<option value="">No hay manicuristas disponibles</option>';

            }

        }


        // =====================================================
        // CARGAR CITAS DEL CLIENTE
        // =====================================================

        async function cargarCitas() {

            const lista =
                document.getElementById('listaCitas');


            try {

                const respuesta =
                    await fetch(
                        '/api/citas/consultar',
                        {
                            headers: {
                                'Authorization':
                                    `Bearer ${token}`
                            }
                        }
                    );


                if (
                    respuesta.status === 401 ||
                    respuesta.status === 403
                ) {

                    cerrarSesion();

                    return;

                }


                const datos =
                    await respuesta.json();


                if (
                    !respuesta.ok ||
                    !datos.ok
                ) {

                    throw new Error(
                        datos.mensaje ||
                        'No se pudieron obtener las citas.'
                    );

                }


                const citas =
                    datos.citas;


                lista.innerHTML = '';


                if (
                    !Array.isArray(citas) ||
                    citas.length === 0
                ) {

                    lista.innerHTML =
                        '<li>No tienes citas programadas.</li>';

                    return;

                }


                citas.forEach(cita => {

                    const li =
                        document.createElement('li');


                    const servicio =
                        cita.servicioId?.nombre ||
                        'Servicio no disponible';


                    const manicurista =
                        cita.manicuristaId
                            ? `${cita.manicuristaId.nombre} ${cita.manicuristaId.apellido}`
                            : 'Manicurista no disponible';


                    const fecha =
                        cita.fecha
                            ? new Date(
                                cita.fecha
                            ).toLocaleDateString(
                                'es-CO'
                            )
                            : 'Fecha no disponible';


                    const estado =
                        cita.estado ||
                        'Pendiente';


                    li.textContent =
                        `📌 ${servicio} | Atiende: ${manicurista} | Fecha: ${fecha} | Hora: ${cita.hora} | Estado: ${estado}`;


                    lista.appendChild(li);

                });


            } catch (error) {

                console.error(
                    'Error al cargar citas:',
                    error
                );


                lista.innerHTML =
                    '<li>Error al obtener la lista de citas.</li>';

            }

        }


        // =====================================================
        // AGENDAR CITA
        // =====================================================

        document
            .getElementById('formAgendar')
            .addEventListener(
                'submit',
                async (e) => {

                    e.preventDefault();


                    const servicioId =
                        document
                            .getElementById('servicio')
                            .value;


                    const manicuristaId =
                        document
                            .getElementById('manicurista')
                            .value;


                    const fechaHora =
                        document
                            .getElementById('fecha')
                            .value;


                    const msg =
                        document
                            .getElementById('msgAgendar');


                    msg.textContent = '';


                    if (
                        !servicioId ||
                        !manicuristaId ||
                        !fechaHora
                    ) {

                        msg.textContent =
                            'Debes completar todos los campos.';

                        return;

                    }


                    // Separar fecha y hora

                    const [
                        fecha,
                        hora
                    ] = fechaHora.split('T');


                    try {

                        const respuesta =
                            await fetch(
                                '/api/citas/agendar',
                                {
                                    method: 'POST',

                                    headers: {
                                        'Content-Type':
                                            'application/json',

                                        'Authorization':
                                            `Bearer ${token}`
                                    },

                                    body:
                                        JSON.stringify({
                                            servicioId,
                                            manicuristaId,
                                            fecha,
                                            hora
                                        })
                                }
                            );


                        const datos =
                            await respuesta.json();


                        if (
                            respuesta.status === 401 ||
                            respuesta.status === 403
                        ) {

                            cerrarSesion();

                            return;

                        }


                        if (respuesta.ok) {

                            msg.textContent =
                                '¡Cita agendada con éxito!';


                            document
                                .getElementById(
                                    'formAgendar'
                                )
                                .reset();


                            // Actualizar lista

                            cargarCitas();

                        } else {

                            msg.textContent =
                                datos.mensaje ||
                                'Error al agendar la cita.';

                        }


                    } catch (error) {

                        console.error(
                            'Error al agendar cita:',
                            error
                        );


                        msg.textContent =
                            'Error de conexión al servidor.';

                    }

                }
            );


        // =====================================================
        // CARGAR DATOS DEL PERFIL
        // =====================================================

        function cargarDatosPerfil() {

            const usuarioStr =
                localStorage.getItem('usuario');


            if (!usuarioStr) {
                return;
            }


            try {

                const usuario =
                    JSON.parse(usuarioStr);


                document
                    .getElementById(
                        'correoPerfil'
                    )
                    .value =
                    usuario.correo || '';


            } catch (error) {

                console.error(
                    'Error cargando perfil:',
                    error
                );

            }

        }


        // =====================================================
        // EDITAR PERFIL
        // =====================================================

        document
            .getElementById('formPerfil')
            .addEventListener(
                'submit',
                async (e) => {

                    e.preventDefault();


                    const nombre =
                        document
                            .getElementById(
                                'nombrePerfil'
                            )
                            .value;


                    const correo =
                        document
                            .getElementById(
                                'correoPerfil'
                            )
                            .value;


                    const msg =
                        document
                            .getElementById(
                                'msgPerfil'
                            );


                    try {

                        const respuesta =
                            await fetch(
                                '/api/usuarios/perfil',
                                {
                                    method: 'PUT',

                                    headers: {
                                        'Content-Type':
                                            'application/json',

                                        'Authorization':
                                            `Bearer ${token}`
                                    },

                                    body:
                                        JSON.stringify({
                                            nombre,
                                            correo
                                        })
                                }
                            );


                        const res =
                            await respuesta.json();


                        if (respuesta.ok) {

                            msg.textContent =
                                'Perfil actualizado correctamente.';


                            localStorage.setItem(
                                'usuario',
                                JSON.stringify({
                                    nombre,
                                    correo
                                })
                            );


                        } else {

                            msg.textContent =
                                res.mensaje ||
                                'Error al actualizar perfil.';

                        }


                    } catch (error) {

                        console.error(
                            'Error actualizando perfil:',
                            error
                        );


                        msg.textContent =
                            'Error de conexión al servidor.';

                    }

                }
            );


        // =====================================================
        // CERRAR SESIÓN
        // =====================================================

        document
            .getElementById('btnLogout')
            .addEventListener(
                'click',
                cerrarSesion
            );


        function cerrarSesion() {

            localStorage.removeItem('token');

            localStorage.removeItem('usuario');

            window.location.href =
                '/login';

        }

    </script>

</body>

</html>